    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceRoot}/target/debug/${workspaceRootFolderName}",
            "args": ["--create", "--prefix", "root", "--dfile", "/mnt/defvol/_snapshots/rusnapshot.db", "--to", "/mnt/defvol/_snapshots/", "--from", "/mnt/defvol/_active/root/"],
